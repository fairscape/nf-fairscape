/*
 * Cell Maps pipeline, containerised — one container per stage. 
 * nf-fairscape writes one EVI RO-Crate for the whole run to fairscape.file below.
 */

plugins {
    id 'nf-fairscape@0.1.0'
}

// Used twice: to pick the container tag, and as the softwareVersion main.nf
// hands nf-fairscape. One map so the crate can't claim a version that never ran.
params.versions = [
    image_download : '0.3.0',
    ppi_download   : '0.2.2',
    image_embedding: '0.3.3',
    ppi_embedding  : '0.4.3',
    coembedding    : '1.5.0',
    hierarchy      : '0.2.5',
]

// Built by containers/build.sh — three thin wrappers over the cm4ai/* images,
// three built from PyPI because upstream has no usable amd64 (hierarchy is
// arm64-only; the two ML images are ~8 GB of CUDA torch nothing here uses).
// The idekerlab/cellmaps_* tags the packages' Makefiles push to do not exist.
params.registry = 'nf-cellmaps'
params.containers = [
    image_download : "${params.registry}/imagedownloader:${params.versions.image_download}",
    ppi_download   : "${params.registry}/ppidownloader:${params.versions.ppi_download}",
    image_embedding: "${params.registry}/image_embedding:${params.versions.image_embedding}",
    ppi_embedding  : "${params.registry}/ppi_embedding:${params.versions.ppi_embedding}",
    coembedding    : "${params.registry}/coembedding:${params.versions.coembedding}",
    hierarchy      : "${params.registry}/generate_hierarchy:${params.versions.hierarchy}",
]

// only used to locate the bundled example inputs; the tools come from containers
params.examples_dir = '/path/to/cm4ai-pipeline'

// null -> the U2OS/BioPlex example inputs bundled in the downloader packages,
// the matched set the official cellmaps_pipeline ships (~166/168 genes overlap
// between the two modalities, so coembedding has something to fuse).
params.samples    = null
params.unique     = null
params.edgelist   = null
params.baitlist   = null
params.provenance = null   // one file, covers all four of the above

// Alternative entry points, per modality. A finished crate skips that
// downloader; a CM4AI table runs it against local data instead of the network.
params.image_crate       = null
params.ppi_crate         = null
params.cm4ai_image_table = null
params.cm4ai_apms_table  = null

params.cell_line = 'U2OS'

// appended to each step; see the `test` profile for the useful ones
params.image_download_args   = ''
params.ppi_download_args     = ''
params.image_embedding_args  = ''
params.ppi_embedding_args    = ''
params.coembedding_args      = ''
params.hierarchy_args        = ''

// null -> the DenseNet baked into the image_embedding container, so the step
// runs offline. A local .pth here is staged as an input, so it gets mounted.
params.model_path = null

// a cached HPA proteinatlas.xml.gz (~697 MB); null -> the tool fetches it per run
params.proteinatlasxml = null

params.author = 'CM4AI Pipeline'
params.outdir = "${projectDir}/nf_results_cellmaps_docker"

// -u             else every result, the crate and the work dir end up root-owned
// -v /etc/passwd uid 1000 doesn't exist in the images, so getpwuid() fails and
//                the cellmaps tools write "login": "" into their own provenance
// -e HOME        without a passwd entry HOME is unset and `~` resolves to /,
//                where matplotlib (via coembedding) can't create its config dir
containerRunOptions = '-u $(id -u):$(id -g) -v /etc/passwd:/etc/passwd:ro -e HOME="$NXF_TASK_WORKDIR"'

profiles {

    standard {
        docker.enabled = true
        docker.runOptions = containerRunOptions
    }

    // Coembedding is the only stage that can use a GPU; image embedding hardcodes
    // device='cpu'. Needs the CUDA build (see Dockerfile.coembedding).
    gpu {
        docker.enabled = true
        docker.runOptions = containerRunOptions
        params.containers = params.containers + [
            coembedding: "${params.registry}/coembedding:${params.versions.coembedding}-cu124"
        ]
        process {
            withName: 'COEMBEDDING' { containerOptions = '--gpus all' }
        }
    }

    // The published images, unwrapped. Needs
    // `export NXF_CONTAINER_ENTRYPOINT_OVERRIDE=true` — they set ENTRYPOINT to
    // their own cmd.py, which eats Nextflow's launcher and exits 2. There is no
    // config equivalent in 25.10. Can't run the hierarchy stage on x86 at all.
    upstream {
        docker.enabled = true
        docker.runOptions = containerRunOptions
        params.containers = [
            image_download : "cm4ai/cellmaps_imagedownloader:${params.versions.image_download}",
            ppi_download   : "cm4ai/cellmaps_ppidownloader:${params.versions.ppi_download}",
            image_embedding: "cm4ai/cellmaps_image_embedding:${params.versions.image_embedding}",
            ppi_embedding  : "cm4ai/cellmaps_ppi_embedding:${params.versions.ppi_embedding}",
            coembedding    : "cm4ai/cellmaps_coembedding:${params.versions.coembedding}",
            hierarchy      : "cm4ai/cellmaps_generate_hierarchy:0.3.0.post1",
        ]
    }

    // For an HPC node with no Docker daemon. docker:// pulls from Docker Hub, so
    // combine with -profile upstream or push the wrapper images somewhere first.
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }

    // Minutes instead of an hour, and still exercises every container.
    // Keep --fake_embedder: fake images are all copies of one another, and a
    // real embedder on them produces identical vectors that crash phenograph.
    test {
        params.image_download_args  = '--fake_images'
        params.image_embedding_args = '--fake_embedder'
        params.ppi_embedding_args   = '--dimensions 16'
        params.coembedding_args     = '--fake_embedding'
    }
}

process {
    // HPA and mygene.info both 5xx intermittently. Linear backoff over ~45 min so
    // a transient outage doesn't kill the expensive image branch; the ML steps
    // are deterministic and fail fast.
    withName: 'IMAGE_DOWNLOAD|PPI_DOWNLOAD' {
        errorStrategy = { sleep(60000L * (task.attempt as long)); task.attempt <= 9 ? 'retry' : 'terminate' }
        maxRetries    = 9
    }
}

fairscape {
    file        = "${params.outdir}/ro-crate-metadata.json"
    overwrite   = true
    author      = params.author
    keywords    = ['cm4ai', 'cell-maps', 'proteomics', 'apms', 'hpa', 'containerized', params.cell_line]
    description = "Cell Maps multi-modal cell map (HPA IF image + AP-MS PPI, ${params.cell_line}) built with Nextflow from the stock cellmaps_* tools, one container per stage"

    // root `publisher`; change before releasing a crate
    organization = 'Cell Maps for AI (CM4AI)'
    // naan defaults to 59853 (local); set a registered one before publishing

    // Every step publishes a directory, so without this the crate is six opaque
    // Datasets. Patterns stay off the ~1,860 JPEGs, which would add ~4,000
    // entities for little gain.
    expandDirectories = true
    expandPatterns    = ['**/*.tsv', '**/*.csv', '**/*.json', '**/*.txt', '**/*.cx2']
    expandMaxFiles    = 2000

    // md5 per file -> AI-Ready "verifiable". One full read of ~900 MB.
    checksums = true

    // Record what each image reference actually resolved to. Without it the crate
    // names six tags, and a tag can be repointed at other bits tomorrow.
    containerProvenance = true

    // recursive contentSize per directory; without it the AI-Ready "statistics"
    // criterion reports 0.1 MB instead of 945 MB
    contentSizes = true

    // EVI:Schema per table -> AI-Ready "standards". The embedding tables are 1025
    // columns, so collapse the trailing run into one array property.
    schemas              = true
    schemaPatterns       = ['**/*.tsv', '**/*.csv']
    schemaArrayThreshold = 32

    // Root properties the AI-Ready scorer and the datasheet read. These describe
    // THIS example run — public HPA U2OS images plus the Krogan Lab AP-MS example
    // lists (HSC2) bundled in cellmaps_ppidownloader — not the CM4AI releases.
    metadata = [
        // -- Croissant RAI: provenance of the inputs -----------------------
        'rai:dataCollection'          : 'Secondary use of two public datasets. Immunofluorescence images are downloaded from the Human Protein Atlas (proteinatlas.org) for the U2OS osteosarcoma cell line by cellmaps_imagedownloader, driven by the antibody/gene sample tables shipped in cellmaps_imagedownloader/examples. Protein-protein interactions come from the Krogan Lab AP-MS example edge and bait lists (HSC2 cell line) shipped in cellmaps_ppidownloader/examples. No new laboratory data is generated by this workflow.',
        'rai:dataCollectionType'      : 'Secondary / reused public data: immunofluorescence microscopy (HPA) and affinity purification mass spectrometry (AP-MS)',
        'rai:dataCollectionMissingData': 'The two modalities interrogate overlapping but non-identical protein sets: the image branch covers 168 unique antibody/gene entries and the AP-MS branch 1,009 gene symbols, so the coembedding is built from their intersection and proteins present in only one modality are dropped. HPA images that fail to download are recorded in each step\'s provenance_errors.json rather than silently omitted. No imputation is performed at any stage.',
        'rai:dataBiases'              : 'Both inputs come from immortalized cancer cell lines (U2OS osteosarcoma for imaging, HSC2 for AP-MS) and therefore do not represent the biological variation of primary human tissue. HPA antibody-based localization is biased toward proteins with validated antibodies, and AP-MS interaction data is biased toward the chosen baits and toward abundant, stable complexes. Because the two modalities are drawn from different cell lines, cross-modal relationships in the coembedding reflect general protein biology rather than one cell state.',
        'rai:dataLimitations'         : 'This is the stock Cell Maps demonstration run at example scale, not a production cell map: roughly 166 genes survive the overlap between the two modalities, which is far too few for the hierarchy to be biologically conclusive. Embedding steps are stochastic (node2vec random walks, MUSE autoencoder initialisation), so repeated runs give similar but not identical coordinates. Not for clinical or diagnostic use.',
        'rai:dataUseCases'            : 'Intended as a reproducible, fully provenance-tracked reference execution of the Cell Maps pipeline: validating the toolchain, benchmarking multi-modal embedding and hierarchy construction, and as a worked example of an EVI RO-Crate emitted directly by a Nextflow run. Suitable for method development and teaching; not intended for training production models or for drawing biological conclusions at this scale.',
        'rai:dataReleaseMaintenancePlan': 'Regenerated on demand from this repository: the workflow, the pinned cellmaps_* tool versions, the container images each stage runs in and the input tables fully determine the outputs, and the crate identifiers are deterministic, so re-running reproduces an equivalent crate. No hosted release or long-term archive is promised for this example run.',
        'rai:personalSensitiveInformation': 'None. The inputs contain no personal, demographic or otherwise sensitive attributes - only protein/gene identifiers, antibody identifiers and microscopy images of immortalized cell lines.',

        // -- ethics, governance, access ------------------------------------
        'humanSubjectResearch'  : 'No. All data derive from commercially available, de-identified immortalized human cell lines (U2OS, HSC2); this does not constitute human subjects research.',
        'humanSubjectExemption' : 'Not applicable - research with commercially available de-identified human cell lines does not constitute human subjects research.',
        'deidentified'          : true,
        'fdaRegulated'          : false,
        'ethicalReview'         : 'No separate ethical review was required or obtained for this workflow: it performs secondary computational analysis of already-public cell line data and generates no new laboratory or human subject data.',
        'dataGovernanceCommittee': 'No standing committee governs this example run; responsibility rests with the workflow author named above. Governance of the upstream source data rests with the Human Protein Atlas (proteinatlas.org) and with the Krogan Lab for the AP-MS example lists.',
        'confidentialityLevel'  : 'Unrestricted',
        'prohibitedUses'        : 'These are laboratory and computationally derived data. They must not be used in clinical decision-making, diagnosis, or any context involving patient care. The example-scale hierarchy must not be presented as a validated cell map.',
        'conditionsOfAccess'    : 'Outputs are released under the crate license. Reuse must respect the licenses of the upstream inputs: Human Protein Atlas data is CC BY-SA 3.0 and requires attribution to proteinatlas.org.',
        'usageInfo'             : 'Reproduce with `containers/build.sh && nextflow run main.nf` from examples/cellmaps-docker/; every step, its command line, the container image it ran in, its software version and its outputs are recorded in ro-crate-metadata.json and rendered in ro-crate-datasheet.html.',

        // -- attribution ------------------------------------------------
        // add principalInvestigator / funder / identifier when publishing a run
        'associatedPublication' : 'Clark T, Parker J, Al Manir S, et al. (2024) Cell Maps for Artificial Intelligence: AI-Ready Maps of Human Cell Architecture from Disease-Relevant Cell Lines. bioRxiv 2024.05.21.589311; doi: https://doi.org/10.1101/2024.05.21.589311',
        'citation'              : 'Cell Maps pipeline (idekerlab cellmaps_* tools) executed with Nextflow and nf-fairscape; see https://github.com/idekerlab/cellmaps_pipeline',
        'completeness'          : 'Complete for what it claims to be: all six pipeline stages ran to completion on the bundled example inputs. It is an example-scale demonstration, not a complete cell map.',
    ]
}

// the plugin falls back to these for crate metadata
manifest {
    name            = 'cm4ai-pipeline-cellmaps-docker'
    author          = 'CM4AI Pipeline'
    description     = 'Vanilla Cell Maps pipeline (stock cellmaps_* tools, downloaders -> hierarchy) orchestrated with Nextflow, one container per stage'
    version         = '1.0.0'
    nextflowVersion = '>=25.10'
}
