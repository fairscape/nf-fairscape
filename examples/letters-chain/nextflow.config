plugins { id 'nf-fairscape' }

fairscape {
    file = 'results/ro-crate-metadata.json'
    overwrite = true

    // Core crate fields have dedicated options in the `fairscape` scope:
    author      = 'Ada Lovelace'
    description = 'A three-step demonstration pipeline that builds a letter list, reverses it, and splits it in half — a full provenance chain packaged as a FAIRSCAPE EVI RO-Crate.'
    keywords    = ['example', 'letters-chain', 'coreutils']  // -> root crate keywords (and dataset keywords)
    license     = 'https://spdx.org/licenses/CC-BY-4.0'
    organization = 'Analytical Engine Institute'            

    metadata = [
        name                 : 'letters-chain demonstration crate',  // overrides the workflow/manifest name on the root
        principalInvestigator: 'Ada Lovelace',
        funder               : 'Example Research Program (grant #0000000)',
        associatedPublication: 'https://doi.org/10.1000/example-letters-chain',
        citation             : 'Lovelace A. The letters-chain demonstration pipeline. 2026.',
        contactEmail         : 'ada@example.org',
        conditionsOfAccess   : 'Example crate for demonstration purposes; no access restrictions.',
        copyrightNotice      : 'Copyright (c) 2026 Analytical Engine Institute.'
    ]
}
