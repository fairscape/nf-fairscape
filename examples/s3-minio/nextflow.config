/*
 * Published outputs and the crate itself live in S3; MinIO on localhost serves
 * the API, so this runs with no cloud account. See README.md.
 *
 * The work dir stays local on purpose: Nextflow's `local` executor rejects an
 * s3:// workDir outright ("requires POSIX compatible file system"). A fully
 * remote work dir needs a cloud executor or Fusion. What is exercised here is
 * the plugin's side -- every crate path it reads, checksums and rewrites is an
 * S3 object.
 */

// pinned so the example runs straight from a local `make install`; an unpinned
// id sends Nextflow to the plugin registry for a "latest" that isn't published
plugins { id 'nf-fairscape@0.1.0' }

params.outdir = 's3://nf-prov/results'

aws {
    accessKey = 'minioadmin'
    secretKey = 'minioadmin'
    region    = 'us-east-1'
    client {
        endpoint          = 'http://localhost:9000'
        s3PathStyleAccess = true
    }
}

fairscape {
    file      = "${params.outdir}/ro-crate-metadata.json"
    overwrite = true

    author       = 'Ada Lovelace'
    organization = 'Analytical Engine Institute'
    description  = 'The letters-chain demonstration, published to an S3 bucket, as an object-store portability check for nf-fairscape.'
    keywords     = ['example', 'letters-chain', 's3', 'object-store']
    license      = 'https://spdx.org/licenses/CC-BY-4.0'

    // everything that reads file bytes -- these are the paths that have to cope
    // with a non-POSIX filesystem
    checksums         = true
    contentSizes      = true
    expandDirectories = true
    expandPatterns    = ['**/*.txt']
    schemas           = true
    schemaPatterns    = ['**/*.txt']

    metadata = [
        name                 : 'letters-chain S3 crate',
        principalInvestigator: 'Ada Lovelace',
        contactEmail         : 'ada@example.org'
    ]
}
