plugins { id 'nf-fairscape' }

params.outdir = 'results'
outputDir = params.outdir

fairscape {
    file = "${params.outdir}/ro-crate-metadata.json"
    overwrite = true
    // the expensive paths, so the odd files below are actually walked, hashed and parsed
    expandDirectories = true
    checksums         = true
    contentSizes      = true
    schemas           = true
}

manifest {
    // authorship goes in `contributors` -- `manifest.author` is deprecated,
    // and this is where the crate's `author` comes from
    contributors = [
        [name: 'Grace Hopper', affiliation: 'Analytical Engine Institute', orcid: '0000-0002-1825-0097', contribution: ['author']],
    ]
    name = 'edge-cases'
    description = 'Publishing and tabular edge cases that a crate has to survive: moved files, non-ASCII names, an empty table, duplicate headers, and a file whose extension lies.'
    version = '0.1.0'
    nextflowVersion = '!>=25.10.0'
}
