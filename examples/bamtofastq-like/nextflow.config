plugins { id 'nf-fairscape@0.1.0' }

params {
    // The same two BAMs nf-core/bamtofastq's `test` profile uses: chr22 of a paired-end
    // human WGS test set, ~200 kB each. The samplesheet here leaves `index` empty so
    // SAMTOOLS_INDEX runs, which nf-core/bamtofastq also supports.
    input  = "${projectDir}/samplesheet.csv"
    outdir = 'results'
}

docker {
    enabled    = true
    runOptions = '-u $(id -u):$(id -g)'
}

process {
    cpus   = 2
    memory = '2.GB'
    time   = '1.h'
}

// The same reports nf-core pipelines write. execution_trace_*.txt is not decoration: it is
// what examples/nf-core/verify-against-run.py joins the crate against to check that the
// provenance graph describes the run that actually happened.
params.trace_report_suffix = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')

timeline { enabled = true; file = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html" }
report   { enabled = true; file = "${params.outdir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"   }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"     }
dag      { enabled = true; file = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"       }

manifest {
    name        = 'bamtofastq-like'
    author      = 'nf-fairscape examples'
    description = 'The paired-end BAM path of nf-core/bamtofastq 2.2.1, flattened into one file and annotated for nf-fairscape'
    mainScript  = 'main.nf'
    version     = '1.0.0'
}

fairscape {
    file      = "${params.outdir}/ro-crate-metadata.json"
    overwrite = true

    // ---- identity and attribution --------------------------------------------------
    author       = 'nf-fairscape examples'
    organization = 'FAIRSCAPE'
    description  = 'Paired-end BAM to FASTQ conversion with QC either side, following the tool sequence of nf-core/bamtofastq 2.2.1. Each alignment is indexed and summarised, split by the mapping state of the read pair, collated so mates are adjacent, written back out as FASTQ, and the mapped and unmapped halves concatenated into one pair of files per sample.'
    keywords     = ['bam-to-fastq', 'samtools', 'sequencing-reads', 'quality-control', 'nf-fairscape-example']
    license      = 'https://spdx.org/licenses/CC-BY-4.0'

    // ---- file description depth ----------------------------------------------------
    expandDirectories   = true
    checksums           = true
    contentSizes        = true
    schemas             = true
    containerProvenance = true

    // ---- long-tail root fields -----------------------------------------------------
    // Everything the FAIRSCAPE profile root understands that has no dedicated option.
    // The rai: keys are Croissant Responsible AI 1.0; the statements are about the public
    // test dataset this example runs on, and are meant to be read as true.
    metadata = [
        identifier             : 'https://doi.org/10.5281/zenodo.4710628',
        principalInvestigator  : 'Friederike Hanssen, Susanne Jodoin (nf-core/bamtofastq)',
        funder                 : 'None - nf-fairscape demonstration run',
        associatedPublication  : 'https://doi.org/10.1038/s41587-020-0439-x',
        citation               : 'Ewels PA, Peltzer A, Fillinger S, et al. The nf-core framework for community-curated bioinformatics pipelines. Nat Biotechnol. 2020;38:276-278.',
        contactEmail           : 'support@fairscape.net',
        conditionsOfAccess     : 'Public. Inputs come from the nf-core/test-datasets bamtofastq branch.',
        copyrightNotice        : 'Workflow and crate: Apache-2.0, FAIRSCAPE. Input alignments: nf-core/test-datasets.',
        confidentialityLevel   : 'normal',
        humanSubjectResearch   : 'No. The inputs are synthetic nf-core test alignments over a 40 kb window of chromosome 22, not data from an identifiable person.',
        ethicalReview          : 'Not applicable - no human subjects data is handled by this run.',
        dataGovernanceCommittee: 'None - public test data, no governed access.',
        prohibitedUses         : 'Nothing here is real sequencing data; do not present the outputs as observations of a biological sample.',

        'rai:dataCollection'              : 'Synthetic paired-end Illumina alignments distributed by nf-core as test data (test-datasets, bamtofastq branch), covering a 40 kb window of chromosome 22.',
        'rai:dataCollectionType'          : 'Secondary use of a public synthetic test dataset.',
        'rai:dataCollectionMissingData'   : 'Nothing is dropped or imputed. Reads whose mate is absent go to the singleton file and unpaired records to the other file, so every input record is accounted for somewhere in the output.',
        'rai:dataBiases'                  : 'Synthetic reads over one small window of one chromosome. Coverage, insert sizes and error profile are artefacts of how the test set was built and say nothing about a real library.',
        'rai:dataUseCases'                : 'Demonstrating and testing provenance capture over a fan-out/fan-in workflow; checking a BAM-to-FASTQ conversion end to end on data small enough to run in a minute.',
        'rai:dataLimitations'             : 'A test-scale run on synthetic data. The FASTQs it produces are only useful for exercising downstream tooling.',
        'rai:personalSensitiveInformation': 'None. The input alignments are synthetic.',
        'rai:dataReleaseMaintenancePlan'  : 'Regenerated from source on demand: the pipeline, its parameters and the input URLs are all in the crate, so any release can be rebuilt rather than archived.',

        additionalProperty: [
            ['@type': 'PropertyValue', name: 'Sequencing platform', value: 'Illumina (simulated)'],
            ['@type': 'PropertyValue', name: 'Library layout',      value: 'Paired-end'],
            ['@type': 'PropertyValue', name: 'Reference window',    value: 'chr22, 40 kb'],
            ['@type': 'PropertyValue', name: 'Samples',             value: 'test, test2'],
            ['@type': 'PropertyValue', name: 'Modelled on',         value: 'nf-core/bamtofastq 2.2.1, paired-end BAM path']
        ]
    ]
}
