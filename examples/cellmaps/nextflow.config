/*
 * Stock Cell Maps pipeline — Nextflow config.
 *
 * nf-fairscape observes the run and writes one EVI RO-Crate for the whole
 * workflow to fairscape.file below.
 *
 * Requires Nextflow >= 25.10.
 */

plugins {
    id 'nf-fairscape@0.1.0'
}


/*
 * Enable process-level Conda environments declared in main.nf.
 *
 * On HPC, strongly consider setting cacheDir to shared/persistent project
 * storage so the six Cell Maps environments are created once and reused.
 */
conda {
    enabled = true

    // Example:
    // cacheDir = '/expanse/lustre/projects/PROJECT/USER/nextflow-conda'
}


/*
 * Workflow inputs.
 *
 * main.nf provides defaults under ${projectDir}/inputs, but any of these can
 * be overridden at runtime, for example:
 *
 *   --samples /path/to/samples.csv
 *   --unique /path/to/unique.csv
 *   --edgelist /path/to/edgelist.tsv
 *   --baitlist /path/to/baitlist.tsv
 *   --provenance /path/to/provenance.json
 */
params.samples    = null
params.unique     = null
params.edgelist   = null
params.baitlist   = null
params.provenance = null

params.cell_line = 'U2OS'


/*
 * Extra arguments appended to each Cell Maps command.
 *
 * Example smoke-test arguments:
 *
 *   --image_download_args='--fake_images'
 *   --image_embedding_args='--fake_embedder --dimensions 16'
 *   --ppi_embedding_args='--dimensions 16'
 *   --coembedding_args='--latent_dimension 16 --n_epochs 5 --k 6'
 */
params.image_download_args   = ''
params.ppi_download_args     = ''
params.image_embedding_args  = ''
params.ppi_embedding_args    = ''
params.coembedding_args      = ''
params.hierarchy_args        = ''


// null -> use/download the image embedding tool's default pretrained model
params.model_path = null


// null -> cellmaps_imagedownloader fetches proteinatlas.xml.gz itself
params.proteinatlasxml = null


params.author = 'CM4AI Pipeline'
params.outdir = "${projectDir}/results"

process {

    /*
     * HPA and mygene.info can intermittently return 5xx errors.
     * Retry only the network-facing downloader stages.
     */
    withName: 'IMAGE_DOWNLOAD|PPI_DOWNLOAD' {
        errorStrategy = {
            sleep(60000L * (task.attempt as long))
            task.attempt <= 9 ? 'retry' : 'terminate'
        }
        maxRetries = 9
    }


    /*
     * Example resource declarations.
     *
     * Tune these for your scheduler/site if needed.
     */
    withName: IMAGE_DOWNLOAD {
        cpus = 2
        memory = 8.GB
    }

    withName: PPI_DOWNLOAD {
        cpus = 2
        memory = 8.GB
    }

    withName: IMAGE_EMBEDDING {
        cpus = 4
        memory = 16.GB
    }

    withName: PPI_EMBEDDING {
        cpus = 4
        memory = 16.GB
    }

    withName: COEMBEDDING {
        cpus = 4
        memory = 16.GB
    }

    withName: HIERARCHY {
        cpus = 4
        memory = 16.GB
    }
}


fairscape {
    file        = "${params.outdir}/ro-crate-metadata.json"
    overwrite   = true
    author      = params.author
    keywords    = [
        'cm4ai',
        'cell-maps',
        'proteomics',
        'apms',
        'hpa',
        params.cell_line
    ]

    description = "Cell Maps multi-modal cell map (HPA IF image + AP-MS PPI, ${params.cell_line}) built with Nextflow from the stock cellmaps_* tools"

    // root `publisher`; change before releasing a crate
    organization = 'Cell Maps for AI (CM4AI)'

    // Every step publishes a directory, so without this the crate is six opaque
    // Datasets. Patterns stay off the large JPEG collections.
    expandDirectories = true
    expandPatterns    = [
        '**/*.tsv',
        '**/*.csv',
        '**/*.json',
        '**/*.txt',
        '**/*.cx2'
    ]
    expandMaxFiles = 2000

    // md5 per file -> AI-Ready "verifiable"
    checksums = true

    // recursive contentSize per directory
    contentSizes = true

    // EVI:Schema per table -> AI-Ready "standards"
    schemas              = true
    schemaPatterns       = ['**/*.tsv', '**/*.csv']
    schemaArrayThreshold = 32

    metadata = [
        // -- Croissant RAI: provenance of the inputs -----------------------
        'rai:dataCollection': 'Secondary use of two public datasets. Immunofluorescence images are downloaded from the Human Protein Atlas (proteinatlas.org) for the U2OS osteosarcoma cell line by cellmaps_imagedownloader, driven by antibody/gene sample tables supplied as workflow inputs. Protein-protein interactions come from AP-MS edge and bait lists supplied as workflow inputs. No new laboratory data is generated by this workflow.',
        'rai:dataCollectionType': 'Secondary / reused public data: immunofluorescence microscopy (HPA) and affinity purification mass spectrometry (AP-MS)',
        'rai:dataCollectionMissingData': 'The two modalities interrogate overlapping but non-identical protein sets, so the coembedding is built from their intersection and proteins present in only one modality are dropped. HPA images that fail to download are recorded in each step\'s provenance_errors.json rather than silently omitted. No imputation is performed at any stage.',
        'rai:dataBiases': 'Both inputs may come from immortalized cancer cell lines and therefore do not represent the biological variation of primary human tissue. HPA antibody-based localization is biased toward proteins with validated antibodies, and AP-MS interaction data is biased toward the chosen baits and toward abundant, stable complexes. If the two modalities come from different cell lines, cross-modal relationships should be interpreted as general protein biology rather than one cell state.',
        'rai:dataLimitations': 'This workflow is intended as a reproducible Cell Maps pipeline execution. Biological interpretation depends on the specific workflow inputs and their scale. Embedding steps may be stochastic, so repeated runs can give similar but not identical coordinates. Not for clinical or diagnostic use.',
        'rai:dataUseCases': 'Intended as a reproducible, provenance-tracked execution of the Cell Maps pipeline for validating the toolchain, benchmarking multi-modal embedding and hierarchy construction, method development, and teaching.',
        'rai:dataReleaseMaintenancePlan': 'Regenerated on demand from this repository: the workflow, pinned cellmaps_* tool versions, environment definitions, and supplied input tables determine the execution environment and outputs. No hosted release or long-term archive is promised for this example run.',
        'rai:personalSensitiveInformation': 'None. The expected inputs contain no personal, demographic, or otherwise sensitive attributes - only protein/gene identifiers, antibody identifiers, microscopy images, and interaction data.',

        // -- ethics, governance, access ------------------------------------
        'humanSubjectResearch': 'No. The workflow is designed for secondary computational analysis of public or otherwise permitted biological data and generates no new human subject data.',
        'humanSubjectExemption': 'Not applicable for the stock cell-line example workflow.',
        'deidentified': true,
        'fdaRegulated': false,
        'ethicalReview': 'No separate ethical review is required for the stock example workflow when it operates only on public cell-line data.',
        'dataGovernanceCommittee': 'No standing committee governs this example run; responsibility rests with the workflow author named above. Governance of upstream data remains with the corresponding data providers.',
        'confidentialityLevel': 'Unrestricted',
        'prohibitedUses': 'These are laboratory and computationally derived data. They must not be used in clinical decision-making, diagnosis, or patient care without appropriate independent validation.',
        'conditionsOfAccess': 'Outputs are released under the crate license. Reuse must respect the licenses and terms of the upstream input datasets.',
        'usageInfo': 'Reproduce with `nextflow run main.nf` from the workflow directory. Every step, its command line, its software metadata, and its outputs are recorded in ro-crate-metadata.json and rendered by nf-fairscape.',

        // -- attribution ----------------------------------------------------
        'associatedPublication': 'Clark T, Parker J, Al Manir S, et al. (2024) Cell Maps for Artificial Intelligence: AI-Ready Maps of Human Cell Architecture from Disease-Relevant Cell Lines. bioRxiv 2024.05.21.589311; doi: https://doi.org/10.1101/2024.05.21.589311',
        'citation': 'Cell Maps pipeline (idekerlab cellmaps_* tools) executed with Nextflow and nf-fairscape; see https://github.com/idekerlab/cellmaps_pipeline',
        'completeness': 'Complete for the stages and inputs supplied to this workflow. Biological completeness depends on the specific datasets used.'
    ]
}


/*
 * The plugin falls back to these for crate metadata.
 */
manifest {
    name            = 'cm4ai-pipeline-cellmaps'
    author          = 'CM4AI Pipeline'
    description     = 'Vanilla Cell Maps pipeline (stock cellmaps_* tools, downloaders -> hierarchy) orchestrated with Nextflow'
    version         = '1.0.0'
    nextflowVersion = '>=25.10'
}
