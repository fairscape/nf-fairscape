/*
 * nf-fairscape annotations for cm4ai-pipeline-cellmaps
 * Generated 2026-09-08 by nf-fairscape annotator (fairscape-annotate skill).
 *
 * Layer onto the run with `-c`:
 *     nextflow run main.nf -c fairscape-annotations.config
 *
 * Every value below was derived from the workflow source, the installed software and the
 * machine it was inventoried on; the evidence is in the report next to this file. Lines
 * marked REVIEW are things the annotator could not establish -- fill them in or delete them.
 */

process {
    // REVIEW: softwareVersion: the executed checkout is 11 commits past tag v0.3.0 (HEAD c41f6b8, last
    //     commit 2026-02-20 'allow all tag to download all cell lines') but still declares 0.3.0;
    //     consider recording 'git:c41f6b8' alongside 0.3.0 if exact-code provenance matters
    // REVIEW: softwareAuthor: package metadata names only 'Cell Maps team'; AUTHORS.rst lists Leah
    //     Schaffer, Gege Qian, Christopher Churas (Ideker Lab, UC San Diego) if individual authors are
    //     wanted
    withName: 'IMAGE_DOWNLOAD' {
        ext.fairscape = [
            softwareName       : 'Cell Maps Image Downloader',
            softwareVersion    : '0.3.0',
            softwareAuthor     : 'Cell Maps team',
            softwareDescription: 'A tool to download immunofluorescence images from the Human Protein Atlas and assemble them, with per-gene node attributes, into a cellmaps image RO-Crate. This process runs the image_download subcommand of cellmaps_imagedownloadercmd.py on a samples CSV for the configured cell line (U2OS in the demo config), with provenance JSON and an optional local proteinatlas.xml.gz to resolve image URLs.',
            softwareUrl        : 'https://github.com/idekerlab/cellmaps_imagedownloader',
            softwareFormat     : 'application/x-python',
            softwareKeywords   : ['immunofluorescence', 'image-download', 'human-protein-atlas', 'cell-maps', 'ro-crate', 'cm4ai']
        ]
    }

    // REVIEW: softwareVersion: installed checkout is 5 commits past tag v0.2.2 (HEAD eea57b8, 2026-06-02:
    //     docs, Dockerfile, runner docstrings) with __version__ unchanged at 0.2.2; record 'git:eea57b8'
    //     alongside if exact provenance is wanted
    // REVIEW: softwareAuthor: package metadata names only 'Cell Maps team' (tools@cm4ai.org); git authors
    //     are Chris Churas and Joanna Lenkiewicz, copyright The Regents of the University of California;
    //     add if individual/institutional attribution is wanted
    // REVIEW: softwareDescription: the CRLF sed clause describes a workflow-side patch in main.nf, not
    //     the tool; drop the final clause if the description should cover the tool only
    withName: 'PPI_DOWNLOAD' {
        ext.fairscape = [
            softwareName       : 'Cell Maps PPI Downloader',
            softwareVersion    : '0.2.2',
            softwareAuthor     : 'Cell Maps team',
            softwareDescription: 'A tool to load AP-MS protein-protein interaction data (edge list + bait list) and assemble it, with per-gene node attributes, into a cellmaps PPI RO-Crate. This process runs cellmaps_ppidownloadercmd.py on the pipeline\'s edgelist, baitlist and provenance inputs to write the ppi_download crate (PPI edge list and gene node attribute TSVs, registered with FAIRSCAPE), then a workflow-side sed strips CRLF line endings from the output TSVs so gene names match downstream embeddings.',
            softwareUrl        : 'https://github.com/idekerlab/cellmaps_ppidownloader',
            softwareFormat     : 'application/x-python',
            softwareKeywords   : ['protein-protein-interaction', 'ap-ms', 'edgelist', 'cell-maps', 'ro-crate', 'fairscape']
        ]
    }

    // REVIEW: softwareVersion: checkout is 4 commits past tag v0.3.3 (HEAD 0919940, 2026-04-30, adds a
    //     --device flag; other 3 commits are docs only) with __version__ unchanged; consider recording
    //     'git:0919940' alongside 0.3.3 if exact provenance matters
    // REVIEW: softwareAuthor: package metadata names only 'Cell Maps team'; AUTHORS.rst lists Leah
    //     Schaffer, Gege Qian, Wei Ouyang, Casper Winsnes, Christopher Churas if individual authors are
    //     wanted
    withName: 'IMAGE_EMBEDDING' {
        ext.fairscape = [
            softwareName       : 'Cell Maps ImmunoFluorescent Image Embedder',
            softwareVersion    : '0.3.3',
            softwareAuthor     : 'Cell Maps team',
            softwareDescription: 'A tool to generate embeddings from HPA IF images; produces 1024-dimensional immunofluorescence image embeddings using a pretrained DenseNet convolutional model. In this process it runs cellmaps_image_embeddingcmd.py on the cellmaps_imagedownloader RO-Crate (--inputdir) with the default DenseNet121 checkpoint auto-downloaded from CellProfiling/densenet (params.model_path is null), fold 1, CPU inference, and writes the embeddings to image_emd.tsv in a new RO-Crate.',
            softwareUrl        : 'https://github.com/idekerlab/cellmaps_image_embedding',
            softwareFormat     : 'application/x-python',
            softwareKeywords   : [
                'image-embedding',
                'immunofluorescence',
                'human-protein-atlas',
                'densenet',
                'deep-learning',
                'cell-maps'
            ]
        ]
    }

    // REVIEW: softwareVersion: checkout HEAD 4160147 is 2 commits past the v0.4.3 tag (last commit
    //     2025-07-25) with an unchanged __version__; editable install means those commits run under the
    //     0.4.3 label. Add 'git:4160147' alongside if exact provenance matters.
    // REVIEW: softwareAuthor: package metadata names only 'Cell Maps team' (tools@cm4ai.org); git log
    //     contributors are Chris Churas, Joanna Lenkiewicz, Leah Schaffer (Ideker Lab, UC San Diego) if
    //     individual authors are wanted.
    withName: 'PPI_EMBEDDING' {
        ext.fairscape = [
            softwareName       : 'Cell Maps PPI Embedder',
            softwareVersion    : '0.4.3',
            softwareAuthor     : 'Cell Maps team',
            softwareDescription: 'A tool to generate embeddings from networks; embeds a protein-protein interaction network into a vector space using the node2vec random-walk algorithm. This process runs the ppi_embedding sub-command of cellmaps_ppi_embeddingcmd.py on the ppi_edgelist.tsv in the upstream PPI download crate with the tool\'s defaults (1024 dimensions, walk length 80, 10 walks per node, p=2, q=1), since params.ppi_embedding_args is empty.',
            softwareUrl        : 'https://github.com/idekerlab/cellmaps_ppi_embedding',
            softwareFormat     : 'application/x-python',
            softwareKeywords   : ['node2vec', 'network-embedding', 'protein-protein-interaction', 'graph', 'cell-maps', 'cm4ai']
        ]
    }

    // REVIEW: softwareVersion: the existing annotation and the previous crate say 1.5.0 but the installed
    //     editable package is 1.6.0 (git 1102243, 2 commits after the 1.6.0 HISTORY entry, clean tree);
    //     update main.nf line 152's ext block, and consider recording the commit for exact provenance
    // REVIEW: softwareAuthor: package metadata names only 'Cell Maps team' (Ideker Lab, UC San Diego;
    //     tools@cm4ai.org); git log shows individual contributors (Jiahao Gao, Leah Schaffer, Joanna
    //     Lenkiewicz, Edrees Noorzay) if individual credit is wanted
    // REVIEW: softwareDescription: algorithm stated as MUSE because params.coembedding_args is '' in both
    //     configs; if a run passes --algorithm proteinprojector/promerge the description should change
    withName: 'COEMBEDDING' {
        ext.fairscape = [
            softwareName       : 'Cell Maps CoEmbedder',
            softwareVersion    : '1.6.0',
            softwareAuthor     : 'Cell Maps team',
            softwareDescription: 'A tool to generate coembeddings from IF image embeddings and PPI network embeddings; fuses the two modalities into a single latent space using the MUSE multi-modal autoencoder. This process runs cellmaps_coembeddingcmd.py on the image-embedding and PPI-embedding directories with the pipeline\'s default arguments (algorithm \'muse\', 128 latent dimensions, 100 training epochs) to produce the coembedding directory for the cell line.',
            softwareUrl        : 'https://github.com/idekerlab/cellmaps_coembedding',
            softwareFormat     : 'application/x-python',
            softwareKeywords   : ['coembedding', 'multimodal', 'autoencoder', 'muse', 'protein-embedding', 'cell-maps']
        ]
    }

    // REVIEW: softwareVersion: the existing annotation and the previous crate say 0.2.5 but the installed
    //     editable package is 0.3.0.post1 (source checkout 2 commits past tag v0.3.0, HEAD 78c0212, clean
    //     tree); update main.nf line 181's ext block, and consider recording git:78c0212 for exact
    //     provenance
    // REVIEW: softwareAuthor: package metadata says only 'Cell Maps team'; AUTHORS.rst lists Leah
    //     Schaffer, Clara Hu, Christopher Churas (Ideker Lab, UC San Diego) if individual authors are
    //     wanted
    // REVIEW: softwareDescription: the 0.3.0 --weighted_edgelist option is not used by this process
    //     (hierarchy_args is empty); the stated defaults apply only while that stays empty
    withName: 'HIERARCHY' {
        ext.fairscape = [
            softwareName       : 'Cell Maps Generate Hierarchy',
            softwareVersion    : '0.3.0.post1',
            softwareAuthor     : 'Cell Maps team',
            softwareDescription: 'A tool to generate hierarchies from protein to protein interaction networks; builds a multi-scale hierarchical cell map from the coembedding using the HiDeF community-detection algorithm. This process runs cellmaps_generate_hierarchycmd.py on the coembedding directory: it builds cosine-similarity PPI networks from the coembedding at a series of cutoffs, feeds them to HiDeF (Leiden community detection, k=10, maxres=80) via CDAPS, refines the hierarchy (containment 0.75, Jaccard 0.9, minimum system size 4), and writes it in HCX/CX2 format with a Cytoscape.js layout.',
            softwareUrl        : 'https://github.com/idekerlab/cellmaps_generate_hierarchy',
            softwareFormat     : 'application/x-python',
            softwareKeywords   : [
                'cell-maps',
                'hierarchy',
                'hidef',
                'community-detection',
                'protein-interaction-network',
                'coembedding'
            ]
        ]
    }
}

fairscape {
    author       = 'CM4AI Pipeline'
    organization = 'Cell Maps for AI (CM4AI)'
    description  = 'Cell Maps multi-modal cell map (HPA IF image + AP-MS PPI, U2OS) built with Nextflow from the stock cellmaps_* tools'
    keywords     = [
        'cm4ai',
        'cell-maps',
        'proteomics',
        'apms',
        'hpa',
        'U2OS',
        'immunofluorescence',
        'protein-localization',
        'node2vec',
        'MUSE',
        'HiDeF',
        'hierarchy',
        'RO-Crate'
    ]

    // REVIEW: principalInvestigator: not stated in the workflow, README or config; add the PI of the run
    //     before releasing (scores key_actors_identified)
    // REVIEW: funder: not stated anywhere; add the grant (CM4AI is NIH Bridge2AI OT2OD032742 but the
    //     config does not say so, so it was not written)
    // REVIEW: identifier: add the DOI once this run is released; the root ARK ark:59853 is the plugin's
    //     local default naan
    // REVIEW: contactEmail: not stated; the tools list tools@cm4ai.org but that is the software team, not
    //     this run's contact
    // REVIEW: license: not set in the config, so the plugin defaults to Apache-2.0 (the nf-fairscape repo
    //     license); the crate bundles HPA images which are CC BY 4.0, so confirm the data license you
    //     intend (CC BY 4.0 would be the natural choice) and set fairscape.license
    // REVIEW: author: 'CM4AI Pipeline' (nextflow.config) / 'DemoCellMap' (demo.config) are placeholders,
    //     not a person or Person entity; put a real name before publishing
    // REVIEW: CHANGED conditionsOfAccess: HPA license corrected from 'CC BY-SA 3.0' to 'CC BY 4.0' per
    //     https://www.proteinatlas.org/about/licence (fetched 2026-09-08); added MIT for the tools and
    //     the DenseNet checkpoint source
    // REVIEW: CHANGED rai:dataCollectionMissingData: replaced the 'provenance_errors.json' claim (no such
    //     file exists in results/) with error.log / image_gene_node_attributes.errors, and replaced '168
    //     entries / 1,009 symbols' with the measured 164 embedded genes, 16 skipped images and mygene
    //     symbol renames
    // REVIEW: CHANGED rai:dataLimitations: 'roughly 166 genes' -> 164 genes (coembedding_emd.tsv rows)
    //     and added the 45-system hierarchy size, HiDeF stochasticity, live HPA fetch and lack of
    //     hierarchy evaluation
    // REVIEW: CHANGED rai:dataBiases: appended the single-bait (PIK3CA) star-network fact and the
    //     DenseNet pretraining source; the original sentences are unchanged
    // REVIEW: keywords: 7 tool/modality keywords appended to the config's 6; drop any you do not want on
    //     the root
    // REVIEW: irb/irbProtocolId: omitted; no human subjects (cell lines only), so leave unset unless your
    //     institution requires a determination letter
    // REVIEW: The 'Previous run scale' and compute PropertyValues describe the 2026-09-03 run on this
    //     host; regenerate them if the run moves to another machine
    metadata = [
        'rai:dataCollection'              : 'Secondary use of two public datasets. Immunofluorescence images are downloaded from the Human Protein Atlas (proteinatlas.org) for the U2OS osteosarcoma cell line by cellmaps_imagedownloader, driven by the antibody/gene sample tables shipped in cellmaps_imagedownloader/examples. Protein-protein interactions come from the Krogan Lab AP-MS example edge and bait lists (HSC2 cell line) shipped in cellmaps_ppidownloader/examples. No new laboratory data is generated by this workflow.',
        'rai:dataCollectionType'          : 'Secondary / reused public data: immunofluorescence microscopy (HPA) and affinity purification mass spectrometry (AP-MS)',
        'rai:dataCollectionMissingData'   : 'The two modalities interrogate overlapping but non-identical protein sets: the image branch starts from 168 genes (483 HPA sample images, 243 antibodies, unique.csv) and the AP-MS branch from 1,009 gene symbols in 2,783 edges, so the coembedding is built from their intersection and proteins present in only one modality are dropped. In the previous run 164 of the 168 image genes were embedded: 16 sample images had no URL in the HPA proteinatlas.xml and were skipped (logged in image_download/error.log and image_gene_node_attributes.errors, not silently omitted), and gene symbols are updated through mygene.info so a few names change (for example C12orf65 becomes MTRFR). All 164 image-embedded genes also occur in the AP-MS list, giving a 164-gene, 128-dimensional coembedding. No imputation is performed at any stage; a protein missing from either modality is simply absent from the coembedding and hierarchy.',
        'rai:dataBiases'                  : 'Both inputs come from immortalized cancer cell lines (U2OS osteosarcoma for imaging, HSC2 for AP-MS) and therefore do not represent the biological variation of primary human tissue. HPA antibody-based localization is biased toward proteins with validated antibodies, and AP-MS interaction data is biased toward the chosen baits and toward abundant, stable complexes; the bundled example edge list is a single-bait pull-down (PIK3CA with 2,783 prey), so the PPI branch is a star network with no prey-prey edges and node2vec can only encode shared membership in that one pull-down. Because the two modalities are drawn from different cell lines, cross-modal relationships in the coembedding reflect general protein biology rather than one cell state. The image embedder is a DenseNet121 pretrained on the HPA Kaggle single-cell classification data, so image features are shaped by that training set\'s localization classes.',
        'rai:dataLimitations'             : 'This is the stock Cell Maps demonstration run at example scale, not a production cell map: 164 genes survive the overlap between the two modalities and the resulting hierarchy has 45 systems, which is far too few for it to be biologically conclusive. Embedding steps are stochastic (node2vec random walks, MUSE autoencoder initialisation, HiDeF Leiden community detection), so repeated runs give similar but not identical coordinates and systems. HPA images are fetched live, so the image set follows whatever HPA serves at run time. The hierarchy has not been evaluated against reference complexes (cellmaps_hierarchyeval is not part of this workflow). Not for clinical or diagnostic use.',
        'rai:dataUseCases'                : 'Intended as a reproducible, fully provenance-tracked reference execution of the Cell Maps pipeline: validating the toolchain, benchmarking multi-modal embedding and hierarchy construction, and as a worked example of an EVI RO-Crate emitted directly by a Nextflow run. Suitable for method development and teaching; not intended for training production models or for drawing biological conclusions at this scale.',
        'rai:dataReleaseMaintenancePlan'  : 'Regenerated on demand from this repository: the workflow, the pinned cellmaps_* tool versions and the input tables fully determine the outputs, and the crate identifiers are deterministic, so re-running reproduces an equivalent crate. No hosted release or long-term archive is promised for this example run.',
        'rai:personalSensitiveInformation': 'None. The inputs contain no personal, demographic or otherwise sensitive attributes - only protein/gene identifiers, antibody identifiers and microscopy images of immortalized cell lines.',
        humanSubjectResearch              : 'No. All data derive from commercially available, de-identified immortalized human cell lines (U2OS, HSC2); this does not constitute human subjects research.',
        humanSubjectExemption             : 'Not applicable - research with commercially available de-identified human cell lines does not constitute human subjects research.',
        deidentified                      : true,
        fdaRegulated                      : false,
        ethicalReview                     : 'No separate ethical review was required or obtained for this workflow: it performs secondary computational analysis of already-public cell line data and generates no new laboratory or human subject data.',
        dataGovernanceCommittee           : 'No standing committee governs this example run; responsibility rests with the workflow author named above. Governance of the upstream source data rests with the Human Protein Atlas (proteinatlas.org) and with the Krogan Lab for the AP-MS example lists.',
        confidentialityLevel              : 'Unrestricted',
        prohibitedUses                    : 'These are laboratory and computationally derived data. They must not be used in clinical decision-making, diagnosis, or any context involving patient care. The example-scale hierarchy must not be presented as a validated cell map.',
        conditionsOfAccess                : 'Outputs are released under the crate license. Reuse must respect the licenses of the upstream inputs: Human Protein Atlas data and images are released under Creative Commons Attribution 4.0 International (CC BY 4.0) and require citation of proteinatlas.org and the HPA primary publications, with image credits stating Human Protein Atlas; the cellmaps_* tools are MIT licensed; the pretrained DenseNet121 checkpoint comes from github.com/CellProfiling/densenet.',
        usageInfo                         : 'Reproduce with `nextflow run main.nf` from examples/cellmaps/; every step, its command line, its software version and its outputs are recorded in ro-crate-metadata.json and rendered in ro-crate-datasheet.html.',
        associatedPublication             : 'Clark T, Parker J, Al Manir S, et al. (2024) Cell Maps for Artificial Intelligence: AI-Ready Maps of Human Cell Architecture from Disease-Relevant Cell Lines. bioRxiv 2024.05.21.589311; doi: https://doi.org/10.1101/2024.05.21.589311',
        citation                          : 'Cell Maps pipeline (idekerlab cellmaps_* tools) executed with Nextflow and nf-fairscape; see https://github.com/idekerlab/cellmaps_pipeline',
        completeness                      : 'Complete for what it claims to be: all six pipeline stages ran to completion on the bundled example inputs. It is an example-scale demonstration, not a complete cell map.',
        'rai:dataPreprocessingProtocol'   : '1. IMAGE_DOWNLOAD: cellmaps_imagedownloader 0.3.0 resolves each samples.csv entry against HPA proteinatlas.xml.gz and downloads the red, green, blue and yellow channel JPEGs for the U2OS cell line, updating gene symbols via mygene.info and writing per-gene node attribute tables into an image RO-Crate. 2. PPI_DOWNLOAD: cellmaps_ppidownloader 0.2.2 loads the AP-MS edge list and bait list into a PPI RO-Crate (ppi_edgelist.tsv, ppi_gene_node_attributes.tsv); the workflow then strips CRLF line endings from the TSVs so gene names match the image branch. 3. IMAGE_EMBEDDING: cellmaps_image_embedding 0.3.3 resizes the images and runs the pretrained DenseNet121 checkpoint (CellProfiling/densenet v0.1.0, fold 0) on CPU to give one 1024-dimensional embedding per gene. 4. PPI_EMBEDDING: cellmaps_ppi_embedding 0.4.3 runs node2vec (1024 dimensions, walk length 80, 10 walks per node, p=2, q=1) on the edge list. 5. COEMBEDDING: cellmaps_coembedding 1.6.0 fuses the two embeddings with the MUSE multi-modal autoencoder (128 latent dimensions, 100 epochs) over the genes present in both. 6. HIERARCHY: cellmaps_generate_hierarchy 0.3.0.post1 builds cosine-similarity networks from the coembedding at cutoffs 0.001 to 0.1, runs HiDeF (Leiden, k=10, maxres=80) through CDAPS, prunes the hierarchy (containment 0.75, Jaccard 0.9, minimum system size 4) and writes hierarchy.cx2 in HCX format.',
        'rai:dataCollectionTimeframe'     : 'The bundled AP-MS example lists are dated 2023-07-31 in provenance.json. HPA images and gene symbol updates are fetched live from proteinatlas.org and mygene.info at run time, so their content reflects the releases current when the workflow runs; the previous run completed on 2026-09-03.',
        'rai:dataCollectionRawData'       : 'Raw inputs are the five files listed as workflow inputs (samples.csv, unique.csv, edgelist.tsv, baitlist.tsv, provenance.json, all bundled in the downloader packages) plus the HPA JPEGs downloaded during IMAGE_DOWNLOAD (1,868 images, four channels each, in the previous run) and the HPA proteinatlas.xml.gz used to resolve image URLs. The JPEGs are kept in the image_download output directory but are not individually described in the crate.',
        'rai:dataImputationProtocol'      : 'None. No step imputes missing images, edges or embeddings.',
        additionalProperty                : [
            [
                '@type': 'PropertyValue',
                name   : 'Execution host',
                value  : 'oj-B550M-DS3H, Linux 5.15.0-139-generic x86_64, glibc 2.31 (inventoried 2026-09-08 on host oj-B550M-DS3H)'
            ],
            [
                '@type': 'PropertyValue',
                name   : 'CPU',
                value  : 'AMD Ryzen 5 5600X 6-Core Processor, 12 logical CPUs (inventoried 2026-09-08 on host oj-B550M-DS3H)'
            ],
            ['@type': 'PropertyValue', name: 'Memory', value: '31.3 GiB RAM (inventoried 2026-09-08 on host oj-B550M-DS3H)'],
            [
                '@type': 'PropertyValue',
                name   : 'GPU',
                value  : 'NVIDIA GeForce GTX 1080, 8192 MiB, driver 570.133.07, CUDA 12.6 visible to torch; not used by this workflow because cellmaps_image_embedding defaults to --device cpu and the MUSE coembedder hard-codes torch.device(\'cpu\') (inventoried 2026-09-08 on host oj-B550M-DS3H)'
            ],
            [
                '@type': 'PropertyValue',
                name   : 'Container engine',
                value  : 'None; every process runs natively in the cellmap conda environment (no docker, singularity or apptainer found on the host)'
            ],
            [
                '@type': 'PropertyValue',
                name   : 'Workflow engine',
                value  : 'Nextflow 26.04.6 (build 12646) on OpenJDK 21.0.10 (conda build), nf-fairscape plugin 0.2.0, DSL2'
            ],
            [
                '@type': 'PropertyValue',
                name   : 'Python environment',
                value  : 'conda env cellmap at /home/oj/anaconda3/envs/cellmap, Python 3.10.21; torch 2.7.1+cu126, torchvision 0.22.1+cu126, numpy 1.26.4, scipy 1.12.0, pandas 2.3.3, scikit-learn 1.3.2, opencv-python 4.9.0.80, node2vec 0.4.6, gensim 4.4.0, hidef 1.1.5, leidenalg 0.9.1, igraph 0.10.8, networkx 2.8.8, ndex2 3.12.0, cdapsutil 0.3.0, fairscape-cli 1.0.2; cellmaps_* packages installed editable from /home/oj/cellmap checkouts (inventoried 2026-09-08 on host oj-B550M-DS3H)'
            ],
            [
                '@type': 'PropertyValue',
                name   : 'Cell line (imaging)',
                value  : 'U2OS (U-2 OS) human osteosarcoma, Human Protein Atlas immunofluorescence'
            ],
            [
                '@type': 'PropertyValue',
                name   : 'Cell line (AP-MS)',
                value  : 'HSC2 human oral squamous carcinoma, Krogan Lab example AP-MS (provenance.json)'
            ],
            ['@type': 'PropertyValue', name: 'AP-MS bait', value: 'PIK3CA (single bait, 2,783 prey interactions)'],
            [
                '@type': 'PropertyValue',
                name   : 'Imaging modality',
                value  : 'Confocal immunofluorescence, four channels per field (red microtubules, green protein of interest, blue nucleus, yellow endoplasmic reticulum), HPA JPEGs'
            ],
            [
                '@type': 'PropertyValue',
                name   : 'Pretrained model',
                value  : 'DenseNet121 HPA single-cell classifier, CellProfiling/densenet release v0.1.0 fold 0 (external_crop512_focal_slov_hardlog_class_densenet121_dropout_i768_aug2_5folds_fold0_final.pth), auto-downloaded by cellmaps_image_embedding'
            ],
            ['@type': 'PropertyValue', name: 'Embedding dimensions', value: 'image 1024, PPI 1024 (node2vec), coembedding 128 (MUSE)'],
            [
                '@type': 'PropertyValue',
                name   : 'Previous run scale',
                value  : '168 input genes, 1,868 HPA images, 164 image-embedded genes, 1,010 PPI nodes, 164 coembedded genes, 45 hierarchy systems, 1.6 GB of outputs (run of 2026-09-03)'
            ]
        ]
    ]
}
