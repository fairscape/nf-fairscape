/*
 * Cell Maps on UVA Rivanna (clarklab). Layered over ../nextflow.config:
 *   nextflow run main.nf -c rivanna/rivanna.config -profile rivanna
 */

params {
    allocation    = 'clarklab'
    cellmaps_root = System.getenv('CELLMAPS_ROOT') ?: '/project/clarklab/nf/cellmap'

    // main.nf calls <base_dir>/<pkg>/<pkg>/<pkg>cmd.py
    base_dir = "${cellmaps_root}/src"
    python   = System.getenv('CELLMAPS_PYTHON') ?: "${cellmaps_root}/env/bin/python"

    // empty: the dev machine's ~/.local shadowing hacks don't apply here
    extra_ld_library_path = ''
    env_site_packages     = ''

    // main.nf falls back to downloading it if this path is absent
    proteinatlasxml = "${cellmaps_root}/data/proteinatlas.xml.gz"
    model_path      = null

    outdir = "${cellmaps_root}/results"
}

// base config computed these from the params above at parse time
env {
    LD_LIBRARY_PATH = null
    PYTHONPATH      = null
}

// likewise: without this the crate goes to the dev machine's outdir
fairscape.file = "${params.outdir}/ro-crate-metadata.json"

workDir = "${params.cellmaps_root}/work"

profiles {

    rivanna {
        process {
            executor       = 'slurm'
            queue          = 'standard'
            clusterOptions = { "-A ${params.allocation}" }

            cpus   = 2
            memory = '8.GB'
            time   = '4.h'

            withName: 'IMAGE_DOWNLOAD'  { cpus = 2; memory = '8.GB';  time = '12.h' }
            withName: 'PPI_DOWNLOAD'    { cpus = 2; memory = '8.GB';  time = '4.h'  }
            withName: 'IMAGE_EMBEDDING' { cpus = 8; memory = '32.GB'; time = '12.h' }
            withName: 'PPI_EMBEDDING'   { cpus = 4; memory = '16.GB'; time = '4.h'  }
            withName: 'COEMBEDDING'     { cpus = 8; memory = '32.GB'; time = '12.h' }
            withName: 'HIERARCHY'       { cpus = 4; memory = '32.GB'; time = '8.h'  }
        }

        executor {
            queueSize         = 20
            pollInterval      = '30 sec'
            queueStatInterval = '5 min'
            submitRateLimit   = '10 sec'
        }
    }

    smoke {
        params.image_download_args  = '--fake_images'
        params.image_embedding_args = '--fake_embedder'
        params.ppi_embedding_args   = '--dimensions 16'
        params.coembedding_args     = '--fake_embedding'
        params.outdir  = "${params.cellmaps_root}/results_smoke"
        fairscape.file = "${params.cellmaps_root}/results_smoke/ro-crate-metadata.json"
    }
}
