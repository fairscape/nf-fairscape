/*
===============================================================================
 Mini test cohort config for the CM4AI Nextflow pipeline
===============================================================================
 Runs the FULL 8-step pipeline (same main.nf) on a tiny cohort built by
 make_mini_cohort.py, so you can smoke-test the whole DAG + nf-fairscape crate
 in minutes instead of hours.

 Usage (from this mini-example/ directory):
     python make_mini_cohort.py            # build data/  (once)
     nextflow run ../main.nf -c mini.config

 It layers on top of ../nextflow.config: inherit that first so the plugin and
 base params are set, then override the data locations + shrink the ML steps.
===============================================================================
*/

includeConfig '../nextflow.config'

// --- scripts still come from the full project; only the DATA points at the mini cohort ---
mini_dir = "${projectDir}/mini-example"          // projectDir = location of main.nf (../)
params.base_dir          = "${projectDir}/.."    // convert_manifest.py, cellmaps_*, ... live at project root
params.treatment         = 'untreated'           // -> SEC-MS abbrev CTRL

params.images_dir        = "${mini_dir}/data/images/untreated"
params.secms_reports_dir = "${mini_dir}/data/sec-ms/cancer-cells"
params.provenance        = "${mini_dir}/data/sec-ms/provenance.json"
params.outdir            = "${mini_dir}/results"

// Don't use the big pretrained model on the tiny cohort
params.model_path        = null

// Loose thresholds so a handful of proteins still form PPI edges
params.similarity_threshold = 0.5
params.min_shared_fractions = 1

// Shrink the embedding steps to keep the smoke test fast.
//  - image: --fake_embedder (skips DenseNet; reads the node-attrs table only)
//  - ppi:   REAL node2vec on the tiny graph (fake_embedder needs a
//           ppi_gene_node_attributes.tsv that secms_to_edgelist.py doesn't emit;
//           node2vec only needs the edgelist and runs in seconds at this size)
params.image_embedding_args = '--fake_embedder --dimensions 16'
params.ppi_embedding_args   = '--dimensions 16 --num_walks 5 --walk_length 20 --workers 2'
// --k 6 keeps phenograph's k+1 neighbours below the overlapping-gene count
// (MUSE clusters the samples; default k=10 needs >10 genes).
params.coembedding_args     = '--latent_dimension 16 --n_epochs 5 --n_epochs_init 10 --k 6 --batch_size 8'
params.hierarchy_args       = ''

// Give the mini crate its own identity
fairscape {
    file        = "${mini_dir}/results/ro-crate-metadata.json"
    overwrite   = true
    author      = 'CM4AI Pipeline'
    keywords    = ['cm4ai', 'mini-cohort', 'smoke-test', 'untreated']
    description = 'CM4AI mini test cohort (small image + SEC-MS subset) built with Nextflow'
}
