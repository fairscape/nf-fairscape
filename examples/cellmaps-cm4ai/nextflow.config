/*
 * CM4AI Pipeline V2 — Nextflow config. Enabling the nf-fairscape plugin is what
 * replaces every `fairscape-cli track` call from the old bash script: the plugin
 * observes the run and, on success, writes ONE EVI RO-Crate for the whole
 * workflow to fairscape.file below. Needs Nextflow >= 25.10.
 *
 * Paths below are placeholders — point them at your own checkout.
 */

plugins {
    // Pin a version; without one Nextflow tries to resolve "latest" from the
    // registry and fails offline.
    id 'nf-fairscape@0.1.0'
}

// Override any of these on the CLI, e.g. --treatment Paclitaxel
params.treatment            = 'untreated'                 // untreated | Vorinostat | Paclitaxel
params.base_dir             = '/path/to/cm4ai-pipeline'   // where the SCRIPTS (convert_manifest, cellmaps_*, ...) live

// Input data; null -> the base_dir defaults shown here. Point them at a subset
// to run a smaller cohort.
params.images_dir           = null   // default: ${base_dir}/images/${treatment}
params.secms_reports_dir    = null   // default: ${base_dir}/sec-ms/cancer-cells
params.provenance           = null   // default: ${base_dir}/sec-ms/provenance.json

// Appended to each cellmaps step — shrink embedding size / epochs, or add
// --fake_embedder for a fast smoke test.
params.image_embedding_args = ''
params.ppi_embedding_args   = ''
params.coembedding_args     = ''
params.hierarchy_args       = ''

// Interpreter with the ML deps and cellmaps_* packages installed, e.g.
// --python "${params.base_dir}/.venv/bin/python".
params.python               = 'conda run -n subcell python'

// Pretrained image-embedding model, used only if the file exists; otherwise
// step 2 trains from scratch.
params.model_path           = "${params.base_dir}/images/Paclitaxel_embedding/model.pth"

// SEC-MS -> edgelist thresholds
params.similarity_threshold = 0.98
params.min_shared_fractions = 3

params.author               = 'CM4AI Pipeline'
params.outdir               = "${params.base_dir}/nf_results_${params.treatment}"

// Only needed if torch can't find its CUDA libs (e.g. libnvJitLink.so.12); point
// it at the directory holding them, usually under a pip nvidia-* package.
params.extra_ld_library_path = ''

// Exported into every task's environment (conda run inherits it, so torch sees it)
env {
    // ${LD_LIBRARY_PATH:-} keeps this safe under the `set -u` in Nextflow's .command.run
    LD_LIBRARY_PATH = params.extra_ld_library_path ? "${params.extra_ld_library_path}:\${LD_LIBRARY_PATH:-}" : null
}

// FAIRSCAPE provenance (replaces `fairscape-cli track`)
fairscape {
    file         = "${params.outdir}/ro-crate-metadata.json"   // crate dir = its parent
    overwrite    = true
    author       = params.author
    keywords     = ['cm4ai', 'cell-maps', 'proteomics', 'sec-ms', params.treatment]
    description  = "CM4AI multi-modal cell map (IF image + SEC-MS PPI, MDAMB468 ${params.treatment}) built with Nextflow"
    // naan defaults to 59853 (local); set a registered one before publishing to
    // a FAIRSCAPE server.
}

// Manifest fields are used by the plugin as fallbacks for crate metadata.
manifest {
    name        = 'cm4ai-pipeline'
    author      = 'CM4AI Pipeline'
    description = 'CM4AI multi-modal cell mapping pipeline (Nextflow translation of track_pipelinev2.sh)'
    version     = '2.0.0'
    nextflowVersion = '>=25.10'
}
