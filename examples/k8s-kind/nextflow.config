/*
 * Every task runs as a Kubernetes pod. The example directory itself is mounted
 * into the kind node at the same absolute path it has on the host, so the head
 * process (which writes the crate) and the task pods (which write the outputs)
 * agree on where files are. Everything below hangs off projectDir, so the only
 * place an absolute path appears is the kind cluster config. See README.md.
 */

plugins { id 'nf-fairscape@0.1.0' }

params.outdir = "${projectDir}/results"
workDir       = "${projectDir}/work"

process {
    executor  = 'k8s'
    container = 'debian:stable-slim'
}

k8s {
    namespace        = 'default'
    storageClaimName = 'nf-share'
    storageMountPath = "${projectDir}"

    // Pods default to root, and the volume is a host directory -- without this
    // every task output lands in the repo owned by root and needs sudo to clear.
    securityContext = [
        runAsUser : 'id -u'.execute().text.trim() as Integer,
        runAsGroup: 'id -g'.execute().text.trim() as Integer,
        fsGroup   : 'id -g'.execute().text.trim() as Integer
    ]
}

fairscape {
    file      = "${params.outdir}/ro-crate-metadata.json"
    overwrite = true

    author       = 'Ada Lovelace'
    organization = 'Analytical Engine Institute'
    description  = 'The letters-chain demonstration executed on Kubernetes, as an executor-portability check for nf-fairscape.'
    keywords     = ['example', 'letters-chain', 'kubernetes']
    license      = 'https://spdx.org/licenses/CC-BY-4.0'

    checksums         = true
    contentSizes      = true
    expandDirectories = true
    expandPatterns    = ['**/*.txt']
    schemas           = true
    schemaPatterns    = ['**/*.txt']

    metadata = [
        name                 : 'letters-chain Kubernetes crate',
        principalInvestigator: 'Ada Lovelace',
        contactEmail         : 'ada@example.org'
    ]
}
