/*
 * nf-fairscape annotations for nf-core/demo
 * Generated 2026-09-08 by nf-fairscape annotator (fairscape-annotate skill).
 *
 * Layer onto the run with `-c`:
 *     nextflow run main.nf -c fairscape-annotations.config
 *
 * Every value below was derived from the workflow source, the installed software and the
 * machine it was inventoried on; the evidence is in the report next to this file. Lines
 * marked REVIEW are things the annotator could not establish -- fill them in or delete them.
 */

plugins {
    id 'nf-fairscape@0.2.0'
}

process {
    // confidence: medium
    // REVIEW: softwareVersion: 0.12.1 is inferred from the container tag and conda spec; no container
    //     engine or fastqc binary exists on this machine, so the version was not read from a running
    //     environment. The module's versions topic (fastqc --version | sed ...) will confirm it at run
    //     time.
    // REVIEW: softwareUrl: project page (babraham.ac.uk) chosen over the source repo
    //     https://github.com/s-andrews/FastQC; swap if the crate should point at code rather than the
    //     download page.
    // REVIEW: license (not an ext field): sources disagree - nf-core meta.yml says GPL-2.0-only, GitHub
    //     repo and bio.tools say GPL-3.0, bioconda says 'GPL >=3'; the upstream LICENSE.txt was not
    //     readable from raw.githubusercontent, verify before recording a license.
    withName: 'FASTQC' {
        ext.fairscape = [
            softwareName       : 'FastQC',
            softwareVersion    : '0.12.1',
            softwareAuthor     : 'Simon Andrews (Babraham Bioinformatics, Babraham Institute)',
            softwareDescription: 'FastQC is a Java quality-control application for high-throughput sequencing reads: it runs a set of analyses on raw FastQ/BAM files (per-base quality, sequence content, GC distribution, duplication, adapter and overrepresented sequences) and writes an HTML report plus a zip archive of results per file. In this process the nf-core fastqc module renames the staged reads to \'<sample id>[_N].<ext>\', then runs \'fastqc --threads <task.cpus> --memory <task.memory/task.cpus, clamped 100-10000 MB>\' non-interactively on each read file, emitting the *_fastqc.html and *_fastqc.zip reports.',
            softwareUrl        : 'https://www.bioinformatics.babraham.ac.uk/projects/fastqc/',
            softwareFormat     : 'application/java-archive',
            softwareKeywords   : ['quality control', 'fastq', 'sequencing', 'adapters', 'read qc', 'html report']
        ]
    }

    // confidence: medium
    // REVIEW: softwareVersion: 1.4 is inferred from the container tag / conda pin; no container engine or
    //     seqtk binary is available here to verify. Confirm against the run's versions topic (`seqtk 2>&1
    //     | sed -n 's/^Version: //p'`) or the pipeline's software_versions.yml after a run.
    // REVIEW: softwareDescription: assumes task.ext.args is empty (modules.config in nf-core/demo 1.2.0
    //     sets none for SEQTK_TRIM); if a user config adds trimfq flags, update the stated defaults.
    withName: 'SEQTK_TRIM' {
        ext.fairscape = [
            softwareName       : 'seqtk',
            softwareVersion    : '1.4',
            softwareAuthor     : 'Heng Li',
            softwareDescription: 'Seqtk is a fast and lightweight C toolkit for processing sequences in FASTA or FASTQ format, reading gzip-compressed input directly (MIT licensed). This process runs `seqtk trimfq` on each input FastQ file to trim low-quality bases from read ends using the modified Mott algorithm (defaults: error-rate threshold -q 0.05, trim to at least -l 30 bp; no extra ext.args are set in nf-core/demo 1.2.0) and gzips the result to <prefix>_<basename>.fastq.gz.',
            softwareUrl        : 'https://github.com/lh3/seqtk',
            softwareFormat     : 'application/x-executable',
            softwareKeywords   : ['fastq', 'quality-trimming', 'read-preprocessing', 'sequence-processing', 'seqtk', 'trimfq']
        ]
    }

    // confidence: medium
    // REVIEW: softwareVersion: 1.34 comes from the container tag and conda pin only; no container engine
    //     here and multiqc is in none of the local conda envs, so it was not inspected -- confirm from
    //     versions.yml / the versions topic after a real run
    // REVIEW: softwareAuthor: PyPI lists only Phil Ewels and Vlad Savelyev; MultiQC has many contributors
    //     -- use the 2016 paper authors or 'MultiQC contributors' if a broader attribution is wanted
    // REVIEW: softwareUrl: chose the project homepage https://multiqc.info; switch to
    //     https://github.com/MultiQC/MultiQC if the crate should point at source
    // REVIEW: config.process_ext has no withName:MULTIQC entry, so task.ext.args/prefix are empty in this
    //     inventory; if a modules.config in the released pipeline sets them, the description's flag list
    //     is incomplete
    withName: 'MULTIQC' {
        ext.fairscape = [
            softwareName       : 'MultiQC',
            softwareVersion    : '1.34',
            softwareAuthor     : 'Phil Ewels, Vlad Savelyev (Seqera Labs); Ewels et al. 2016',
            softwareDescription: 'MultiQC searches a directory for the logs and reports of many bioinformatics tools and aggregates them across samples into a single interactive HTML report. In nf-core/demo this process runs `multiqc --force .` on the collected FastQC zip outputs plus the pipeline\'s collated software versions, workflow-summary and methods-description YAML, using the pipeline\'s assets/multiqc_config.yml (and optional custom logo, --replace-names / --sample-names files), and emits the report HTML, the multiqc_data directory and optionally the multiqc_plots directory.',
            softwareUrl        : 'https://multiqc.info',
            softwareFormat     : 'application/x-python',
            softwareKeywords   : ['quality-control', 'report-aggregation', 'bioinformatics', 'sequencing', 'html-report', 'fastqc']
        ]
    }

    // confidence: medium
    // REVIEW: softwareVersion: 1.1.5 is inferred from the container tag, the conda spec and the module's
    //     hard-coded versions tuple; no container engine or cowpy install exists on this machine
    //     (probe_env.py container -> available=false; probe_env.py exe cowpy -> not found), so it was not
    //     verified against a running environment
    // REVIEW: softwareDescription: the fetched tree has no conf/modules.config, so task.ext.args for
    //     COWPY could not be read; if the pipeline sets a cowacter (e.g. `-c`), mention it in the
    //     description
    // REVIEW: softwareAuthor: PyPI names only the individual author Jeff Buttars (maintainer field
    //     empty); PyPI summary, home_page and project_urls are blank, so URL and summary come from the
    //     conda-forge recipe and GitHub
    withName: 'COWPY' {
        ext.fairscape = [
            softwareName       : 'cowpy',
            softwareVersion    : '1.1.5',
            softwareAuthor     : 'Jeff Buttars',
            softwareDescription: 'cowpy is a single-file Python re-implementation of the classic cowsay utility: it reads a message from stdin or the command line and prints it as ASCII art spoken by a selectable \'cowacter\'. In the nf-core/demo pipeline this process pipes the string "nf-core rules!" into `cowpy` (with any task.ext.args appended) and captures the ASCII-art output as cowpy.txt; it is a lighthearted illustration of a local module with no nf-core label and a hard-coded versions tuple.',
            softwareUrl        : 'https://github.com/jeffbuttars/cowpy',
            softwareFormat     : 'application/x-python',
            softwareKeywords   : ['cowsay', 'ascii-art', 'text', 'python', 'demo', 'nf-core']
        ]
    }
}

fairscape {
    file      = "${params.outdir}/ro-crate-metadata.json"
    overwrite = true

    description = 'Test-profile run of nf-core/demo 1.2.0, a minimal nf-core pipeline for workshops and demonstrations. It downloads the nf-core/test-datasets viralrecon Illumina amplicon samplesheet (two SARS-CoV-2 amplicon libraries, 27,721 and 21,481 read pairs, plus the same forward reads re-used as one single-end sample), runs FastQC on every FastQ file, trims read ends with seqtk trimfq, aggregates the QC into a MultiQC report with the collated software versions, and writes a cowpy ASCII-art text file. Outputs are QC reports and trimmed FastQ files for a tiny public test set; they demonstrate the pipeline and the provenance crate, not a biological result.'
    keywords    = [
        'nf-core',
        'demo',
        'test-profile',
        'fastq',
        'read-qc',
        'quality-trimming',
        'sars-cov-2',
        'amplicon',
        'illumina',
        'fastqc',
        'seqtk',
        'multiqc',
        'nextflow',
        'workflow'
    ]
    license     = 'https://spdx.org/licenses/MIT'

    // REVIEW: author: the plugin will default to the OS user (oj); set the name of the person who ran
    //     this test-profile run, or a Person entity. The pipeline authors are recorded under
    //     additionalProperty 'Pipeline authors' and citation
    // REVIEW: organization: not stated for the run; the pipeline is an nf-core community project
    //     maintained at Seqera, but the publisher of this crate should be your own institution
    // REVIEW: principalInvestigator: not stated in the workflow or README
    // REVIEW: funder: not stated in the workflow or README
    // REVIEW: identifier: add the DOI once this run is released; associatedPublication carries the
    //     pipeline's Zenodo DOI, not this run's
    // REVIEW: contactEmail: not stated; manifest.contributors lists chris.hakkaart@seqera.io and
    //     geraldine.vdauwera@seqera.io as pipeline maintainers, which are contacts for the pipeline, not
    //     for this run
    // REVIEW: ethicalReview / irb / irbProtocolId / dataGovernanceCommittee: omitted; the inputs are
    //     public viral test reads (humanSubjectResearch set to false), so state explicitly that no review
    //     was required if that is your institution's position
    // REVIEW: license: set to MIT because the pipeline and the nf-core test data are MIT; change it if
    //     you want to release this run's outputs under a different license
    // REVIEW: confidentialityLevel: set to 'unrestricted' for public test data; lower it to 'normal' or
    //     higher if the crate will hold anything else
    // REVIEW: Container engine: none was found on this host, so the run must use -profile test,conda; if
    //     it ran with docker or singularity elsewhere, correct the Container engine and Execution host
    //     entries
    metadata = [
        'rai:dataCollection'              : 'Secondary use of public test data. Under the test profile params.input is https://raw.githubusercontent.com/nf-core/test-datasets/viralrecon/samplesheet/samplesheet_test_illumina_amplicon.csv, a samplesheet the pipeline reads with nf-schema samplesheetToList and validates against assets/schema_input.json (columns sample, fastq_1, fastq_2; gzipped FastQ required). Its rows point at four FastQ files hosted in the viralrecon branch of nf-core/test-datasets (illumina/amplicon/sample1_R1, sample1_R2, sample2_R1, sample2_R2), which that repository describes as small-scale SARS-CoV-2 amplicon primer enriched Illumina test data. Sample1 has 27,721 read pairs and sample2 21,481 read pairs (about 299 bp reads, instrument id M03352 in the read headers); SAMPLE3_SE re-uses sample1_R1 and sample2_R1 as two single-end runs of one sample. No file is generated in-house; the FastQ files are fetched from GitHub by Nextflow when the workflow stages them. No reference genome is used (params.genome is unset and params.fasta is only resolved, never consumed).',
        'rai:dataCollectionType'          : 'Illumina short-read sequencing: gzipped FastQ files from SARS-CoV-2 amplicon libraries, two paired-end samples and one single-end sample assembled from the same forward reads. Outputs are per-file FastQC HTML and zip reports, trimmed FastQ files, a MultiQC HTML report with its multiqc_data tables, a software-versions YAML and a plain-text cowpy file.',
        'rai:dataCollectionMissingData'   : 'No samples or reads are dropped. A missing fastq_2 column marks a row single-end rather than excluding it; rows sharing a sample id are merged into one sample and must agree on endedness (validateInputSamplesheet errors otherwise). FastQC only reports; it filters nothing. seqtk trimfq trims low-quality bases from read ends with its defaults (error-rate threshold 0.05, keep at least 30 bp; no ext.args are set for SEQTK_TRIM in conf/modules.config) and keeps every read. The pipeline does no imputation and applies no quality filter that removes reads or samples; --skip_trim (false here) would skip the trimming step entirely.',
        'rai:dataPreprocessingProtocol'   : '1. nf-schema validates the parameters and reads the samplesheet into per-sample FastQ lists, tagging each sample single- or paired-end. 2. FASTQC (FastQC 0.12.1, ext.args --quiet) renames each staged FastQ to <sample>[_N].fastq.gz and runs fastqc --threads task.cpus --memory task.memory/task.cpus, emitting an HTML report and a zip archive per file. 3. SEQTK_TRIM (seqtk 1.4) runs seqtk trimfq with default settings on each FastQ and gzips the result to <sample>_<original name>. 4. COWPY (cowpy 1.1.5) pipes the string nf-core rules! through cowpy into cowpy.txt; it consumes no data. 5. The versions topic is collated into pipeline_info/nf_core_demo_software_mqc_versions.yml. 6. MULTIQC (MultiQC 1.34) runs multiqc --force on the FastQC zips, the versions file, the workflow-summary and methods-description YAML with assets/multiqc_config.yml, producing multiqc_report.html and multiqc_data. Outputs are published by copy under fastqc/<sample>/, fq/<sample>/, cowpy/, multiqc/ and pipeline_info/.',
        'rai:dataBiases'                  : 'The inputs are a curated test set, not a study: two amplicon libraries of a single virus (SARS-CoV-2) from the nf-core/test-datasets viralrecon branch, subsampled to tens of thousands of reads, with their original sample provenance, sequencing site and amplicon scheme undocumented in that repository. Amplicon primer enrichment concentrates coverage on the targeted regions, and the single-end sample is a duplicate of the paired-end forward reads, so the three samples are not independent. Quality statistics therefore reflect these two libraries and the seqtk defaults, and generalize to no population or sequencing platform.',
        'rai:dataUseCases'                : 'Confirming that nf-core/demo 1.2.0 and its software environments install and run end to end; teaching and demonstrating nf-core pipeline structure, Nextflow provenance and this RO-Crate; inspecting example FastQC and MultiQC reports for read-quality metrics of the test libraries; using the crate as a worked example of run-level FAIRSCAPE metadata.',
        'rai:dataLimitations'             : 'Two subsampled SARS-CoV-2 amplicon libraries of 21,481 to 27,721 read pairs, processed with default trimming and no alignment, variant calling or assembly, so the outputs support no biological or epidemiological conclusion. The QC metrics were not validated against any reference result beyond the pipeline\'s own nf-test suite. The cowpy output is decorative and has no analytical function. Nothing here is validated for clinical or diagnostic use.',
        'rai:personalSensitiveInformation': 'None identified. The inputs are viral amplicon reads published for automated testing in the public nf-core/test-datasets repository, the samplesheet uses generic identifiers (SAMPLE1_PE, SAMPLE2_PE, SAMPLE3_SE) and no patient, donor or location metadata enters the run. The original clinical source of the libraries is not documented in the test-datasets repository.',
        'rai:dataReleaseMaintenancePlan'  : 'Every output is regenerable from this crate with nextflow run nf-core/demo -r 1.2.0 -profile test,docker (or singularity or conda) --outdir results, given that the samplesheet and FastQ files remain at their nf-core/test-datasets URLs (the viralrecon branch has been the pipeline\'s test source across releases). The pipeline is versioned on GitHub with a Zenodo concept DOI (10.5281/zenodo.12192442) and is maintained by the Nextflow community team, Geraldine Van der Auwera and Florian Wuennemann according to its README; the pinned tool versions are available as Bioconda packages and BioContainers or Seqera Wave images. No release or maintenance commitment exists for the outputs of this particular run.',
        humanSubjectResearch              : false,
        deidentified                      : true,
        fdaRegulated                      : false,
        confidentialityLevel              : 'unrestricted',
        conditionsOfAccess                : 'Open. nf-core/demo 1.2.0 is released under the MIT License (Copyright (c) The nf-core/demo team) and the nf-core/test-datasets inputs under the MIT License (Copyright (c) 2018 nf-core); FastQC is GPL-3.0, seqtk MIT, MultiQC GPL-3.0 and cowpy MIT, which govern the tools rather than these outputs.',
        prohibitedUses                    : 'None imposed by the MIT-licensed pipeline and inputs. Do not present these test-profile outputs as evidence about the biological samples, and do not use them for clinical, diagnostic or public-health decisions.',
        usageInfo                         : 'Reproduce with nextflow run nf-core/demo -r 1.2.0 -profile test,docker (or singularity or conda) --outdir results (Nextflow >= 25.10.4, plugin nf-schema@2.7.2). Cite the pipeline as https://doi.org/10.5281/zenodo.12192442 and the nf-core framework as Ewels et al. 2020, Nat Biotechnol 38:276-278; tool references are listed in the pipeline\'s CITATIONS.md.',
        associatedPublication             : 'https://doi.org/10.5281/zenodo.12192442',
        citation                          : [
            'nf-core/demo 1.2.0. https://doi.org/10.5281/zenodo.12192442',
            'Ewels PA, Peltzer A, Fillinger S, Patel H, Alneberg J, Wilm A, Garcia MU, Di Tommaso P, Nahnsen S. The nf-core framework for community-curated bioinformatics pipelines. Nat Biotechnol. 2020;38(3):276-278. https://doi.org/10.1038/s41587-020-0439-x',
            'Di Tommaso P, Chatzou M, Floden EW, Barja PP, Palumbo E, Notredame C. Nextflow enables reproducible computational workflows. Nat Biotechnol. 2017;35(4):316-319. https://doi.org/10.1038/nbt.3820',
            'Andrews S. (2010). FastQC: A Quality Control Tool for High Throughput Sequence Data. https://www.bioinformatics.babraham.ac.uk/projects/fastqc/',
            'Li H. seqtk: Toolkit for processing sequences in FASTA/Q formats. https://github.com/lh3/seqtk',
            'Ewels P, Magnusson M, Lundin S, Kaller M. MultiQC: summarize analysis results for multiple tools and samples in a single report. Bioinformatics. 2016;32(19):3047-3048. https://doi.org/10.1093/bioinformatics/btw354',
            'Buttars J. cowpy. https://github.com/jeffbuttars/cowpy'
        ],
        additionalProperty                : [
            [
                '@type': 'PropertyValue',
                name   : 'Execution host',
                value  : 'oj-B550M-DS3H, Linux 5.15.0-139-generic x86_64, glibc 2.31 (inventoried 2026-09-08 on host oj-B550M-DS3H)'
            ],
            [
                '@type': 'PropertyValue',
                name   : 'CPU',
                value  : 'AMD Ryzen 5 5600X 6-Core Processor, 12 logical CPUs (inventoried 2026-09-08 on host oj-B550M-DS3H)'
            ],
            ['@type': 'PropertyValue', name: 'Memory', value: '31.3 GiB (inventoried 2026-09-08 on host oj-B550M-DS3H)'],
            [
                '@type': 'PropertyValue',
                name   : 'GPU',
                value  : 'NVIDIA GeForce GTX 1080, 8192 MiB, driver 570.133.07 (inventoried 2026-09-08 on host oj-B550M-DS3H); no process in this pipeline uses a GPU'
            ],
            [
                '@type': 'PropertyValue',
                name   : 'Container engine',
                value  : 'None found on the host (inventoried 2026-09-08 on host oj-B550M-DS3H); the modules declare quay.io/biocontainers fastqc:0.12.1--hdfd78af_0 and seqtk:1.4--he4a0461_1, community.wave.seqera.io multiqc:1.34 and cowpy:1.1.5 images with matching Bioconda/conda-forge environment.yml files, so on this host the run must use the conda profile'
            ],
            [
                '@type': 'PropertyValue',
                name   : 'Workflow engine',
                value  : 'Nextflow 26.04.6.12646 on OpenJDK 21.0.10 (conda build) (inventoried 2026-09-08 on host oj-B550M-DS3H); pipeline requires !>=25.10.4; plugin nf-schema@2.7.2'
            ],
            [
                '@type': 'PropertyValue',
                name   : 'Python environment',
                value  : 'No host Python interpreter is used: cowpy 1.1.5 and MultiQC 1.34 run from their own per-process conda-forge/Bioconda environments or Wave containers, FastQC 0.12.1 is Java and seqtk 1.4 is C; none of the host conda envs (base, cellmap, epic, fairscape, pcprophet, prince) provides fastqc, seqtk or multiqc (inventoried 2026-09-08 on host oj-B550M-DS3H)'
            ],
            [
                '@type': 'PropertyValue',
                name   : 'Test profile resource limits',
                value  : 'cpus 2, memory 4 GB, time 1 h per task (conf/test.config resourceLimits)'
            ],
            [
                '@type': 'PropertyValue',
                name   : 'Organism',
                value  : 'Severe acute respiratory syndrome coronavirus 2 (SARS-CoV-2) amplicon libraries, per the nf-core/test-datasets viralrecon README'
            ],
            [
                '@type': 'PropertyValue',
                name   : 'Sequencing platform',
                value  : 'Illumina paired-end, about 299 bp reads, instrument id M03352 and flowcell 000000000-J3R29 in the read headers (MiSeq-style identifiers); library preparation and amplicon scheme not documented in the test-datasets repository'
            ],
            [
                '@type': 'PropertyValue',
                name   : 'Samples',
                value  : 'SAMPLE1_PE (27,721 read pairs, 3.4 MB + 4.1 MB gz), SAMPLE2_PE (21,481 read pairs, 2.4 MB + 2.9 MB gz), SAMPLE3_SE (two single-end runs re-using sample1_R1 and sample2_R1)'
            ],
            [
                '@type': 'PropertyValue',
                name   : 'Pipeline authors',
                value  : 'Christopher Hakkaart (Seqera, ORCID 0000-0001-5007-2684, author and maintainer); Florian Wuennemann (Seqera, 0000-0002-0978-6076, maintainer); Geraldine Van der Auwera (Seqera, 0000-0001-9751-7820, maintainer); James A. Fellows Yates (Leibniz-HKI / MPI-EVA, 0000-0001-5585-6277, contributor), from manifest.contributors'
            ]
        ]
    ]
}
