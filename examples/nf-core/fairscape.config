// Everything on, so a run exercises the expensive paths (directory walk, md5 per file,
// schema per table, container inspect) against real pipeline output.
//
// Layered onto someone else's pipeline with `-c`, so it sets nothing but the fairscape
// scope: the pipeline's own nextflow.config still decides profiles, resources and modules.
plugins {
    id 'nf-fairscape@0.1.0'
}

fairscape {
    file                = "${params.outdir}/ro-crate-metadata.json"
    overwrite           = true
    expandDirectories   = true
    checksums           = true
    contentSizes        = true
    schemas             = true
    containerProvenance = true
}
