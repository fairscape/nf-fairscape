plugins { id 'nf-fairscape' }

params.outdir = 'results'
outputDir = params.outdir

fairscape {
    file = "${params.outdir}/ro-crate-metadata.json"
    overwrite = true
}

manifest {
    // authorship goes in `contributors` -- `manifest.author` is deprecated,
    // and this is where the crate's `author` comes from
    contributors = [
        [name: 'Ada Lovelace', affiliation: 'Analytical Engine Institute', orcid: '0000-0002-1825-0097', contribution: ['author']],
    ]
    name = 'cycle-repro'
    description = 'A file Nextflow writes, a task consumes and the run publishes — the shape that used to make the provenance graph cyclic.'
    version = '0.1.0'
    nextflowVersion = '!>=25.10.0'
}
