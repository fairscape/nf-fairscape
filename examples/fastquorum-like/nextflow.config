plugins { id 'nf-fairscape@0.1.0' }

params {
    // Same inputs as nf-core/fastquorum's `test` profile: the tiny subsample of SRR6109255
    // (9,901 read pairs) and hg38 chromosome 17.
    input  = "${projectDir}/samplesheet.csv"
    fasta  = 'https://raw.githubusercontent.com/nf-core/test-datasets/fastquorum/references/chr17.fa'
    outdir = 'results'

    // The values nf-core/fastquorum 2.0.0 resolves to for `duplex_seq = true`, from its
    // nextflow.config defaults and the branch at the top of its main.nf.
    groupreadsbyumi_strategy   = 'Paired'
    groupreadsbyumi_edits      = 1
    call_min_reads             = '1 1 0'
    call_min_baseq             = 10
    filter_min_reads           = '3 1 1'
    filter_min_baseq           = 10
    filter_max_base_error_rate = 0.1
}

docker {
    enabled    = true
    runOptions = '-u $(id -u):$(id -g)'
}

// 9,901 read pairs against chromosome 17, so nothing here needs more than a laptop. fgbio
// is a JVM tool and reads `task.memory` for its heap, so every process needs one set.
process {
    cpus   = 2
    memory = '4.GB'
    time   = '1.h'

    withName: FASTQC { memory = '2.GB' }
}

// The same reports nf-core pipelines write. execution_trace_*.txt is not decoration: it is
// what examples/nf-core/verify-against-run.py joins the crate against to check that the
// provenance graph describes the run that actually happened.
params.trace_report_suffix = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')

timeline { enabled = true; file = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html" }
report   { enabled = true; file = "${params.outdir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"   }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"     }
dag      { enabled = true; file = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"       }

manifest {
    name        = 'fastquorum-like'
    author      = 'nf-fairscape examples'
    description = 'The duplex path of nf-core/fastquorum 2.0.0, flattened into one file and annotated for nf-fairscape'
    mainScript  = 'main.nf'
    version     = '1.0.0'
}

fairscape {
    file      = "${params.outdir}/ro-crate-metadata.json"
    overwrite = true

    // ---- identity and attribution --------------------------------------------------
    author       = 'nf-fairscape examples'
    organization = 'FAIRSCAPE'
    description  = 'Duplex-UMI consensus calling on CRISPR-DS TP53 amplicon sequencing (SRR6109255), following the tool sequence and parameter defaults of nf-core/fastquorum 2.0.0 in rd mode. Raw reads are converted to an unmapped BAM with UMIs in the RX tag, aligned, grouped into source molecules, collapsed to duplex consensus reads, realigned and filtered to true duplex observations.'
    keywords     = ['duplex-sequencing', 'umi', 'consensus-calling', 'fgbio', 'tp53', 'nf-fairscape-example']
    license      = 'https://spdx.org/licenses/CC-BY-4.0'

    // ---- file description depth ----------------------------------------------------
    // All of it, so a run exercises every expensive path against real output.
    //
    // `schemas` describes exactly one file on this pipeline, the samplesheet: fgbio writes
    // its metrics tab-delimited but names them .txt, and the inferrer is gated on the
    // extension (csv/tsv only), so widening `schemaPatterns` would not reach them. Those
    // tables get Datasets with checksums and provenance edges, just no column schema.
    expandDirectories   = true
    checksums           = true
    contentSizes        = true
    schemas             = true
    containerProvenance = true

    // ---- long-tail root fields -----------------------------------------------------
    // Everything the FAIRSCAPE profile root understands that has no dedicated option.
    // The rai: keys are Croissant Responsible AI 1.0; the statements are about the public
    // test dataset this example runs on, and are meant to be read as true.
    metadata = [
        identifier             : 'https://doi.org/10.5281/zenodo.10456900',
        principalInvestigator  : 'Nils Homer (nf-core/fastquorum)',
        funder                 : 'None - nf-fairscape demonstration run',
        associatedPublication  : 'https://doi.org/10.1101/gr.235291.118',
        citation               : 'Nachmanson D, Lian S, Schmidt EK, et al. Targeted genome fragmentation with CRISPR/Cas9 enables fast and efficient enrichment of small genomic regions and ultra-accurate sequencing with low DNA input (CRISPR-DS). Genome Res. 2018;28(10):1589-1599.',
        contactEmail           : 'support@fairscape.net',
        conditionsOfAccess     : 'Public. Inputs come from the nf-core/test-datasets fastquorum branch.',
        copyrightNotice        : 'Workflow and crate: Apache-2.0, FAIRSCAPE. Input reads: nf-core/test-datasets.',
        confidentialityLevel   : 'normal',
        humanSubjectResearch   : 'Reads are from a published CRISPR-DS methods study (SRA SRR6109255) redistributed as an nf-core test dataset; no subject-level data is handled by this run.',
        ethicalReview          : 'Covered by the ethics approval of the originating CRISPR-DS study (Nachmanson et al. 2018); no new human data was collected.',
        dataGovernanceCommittee: 'None - public test data, no governed access.',
        prohibitedUses         : 'Not for clinical interpretation. This is a subsampled test run against a single chromosome.',

        'rai:dataCollection'              : 'Illumina MiSeq duplex sequencing of a CRISPR-Cas9 fragmented TP53 region (CRISPR-DS), deposited as SRA run SRR6109255 and subsampled by nf-core into the fastquorum test-dataset branch.',
        'rai:dataCollectionType'          : 'Secondary use of a public sequencing dataset.',
        'rai:dataCollectionMissingData'   : 'No imputation. Consensus reads with fewer than three supporting raw reads, or without at least one read from each strand, are dropped by FilterConsensusReads rather than filled in; uncertain individual bases are masked to N.',
        'rai:dataBiases'                  : 'One sample, one target locus, one library preparation, subsampled to 9,901 read pairs for testing. Nothing here is representative of a genome-wide or multi-sample run.',
        'rai:dataUseCases'                : 'Demonstrating and testing provenance capture over a real UMI consensus-calling workflow; comparing consensus parameters on a small, fast dataset.',
        'rai:dataLimitations'             : 'A test-scale run. Not validated for clinical or diagnostic use, and the subsampled depth is far below what duplex variant calling requires in practice.',
        'rai:personalSensitiveInformation': 'None. The input is a public, de-identified SRA run covering a single gene.',
        'rai:dataReleaseMaintenancePlan'  : 'Regenerated from source on demand: the pipeline, its parameters and the input URLs are all in the crate, so any release can be rebuilt rather than archived.',

        additionalProperty: [
            ['@type': 'PropertyValue', name: 'Sequencing platform', value: 'Illumina MiSeq'],
            ['@type': 'PropertyValue', name: 'Library preparation', value: 'CRISPR-DS duplex sequencing'],
            ['@type': 'PropertyValue', name: 'Target region',       value: 'TP53, hg38 chr17:7,668,402-7,687,550'],
            ['@type': 'PropertyValue', name: 'Read structure',      value: '10M1S+T 10M1S+T'],
            ['@type': 'PropertyValue', name: 'Modelled on',         value: 'nf-core/fastquorum 2.0.0, rd mode, duplex_seq = true']
        ]
    ]
}
